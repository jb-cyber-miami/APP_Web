# Copy to .env for local development. NEVER commit the real .env file.
# In production (Cloud Run) these come from Secret Manager / env vars: see docs/DEPLOY_FIREBASE.md.

APP_ENV=development              # development | production
SECRET_KEY=                       # python -c "import secrets; print(secrets.token_hex(32))"
DATABASE_URL=sqlite:///workout.db # production: your Postgres URL
TOKEN_ENCRYPTION_KEY=             # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DEFAULT_TIMEZONE=America/New_York

# Local http://localhost only. Leave unset (true) in production.
SESSION_COOKIE_SECURE=false

# --- Google sign-in (optional) --- https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://YOUR-DOMAIN/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Oura Ring (optional) --- https://cloud.ouraring.com/oauth/applications
# Redirect URI: https://YOUR-DOMAIN/integrations/oura/callback
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=

# --- AI workout builder (optional) --- https://console.anthropic.com/
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# Max Claude calls per user per day (AI builder + Today plan + swaps). Real cost cap.
AI_DAILY_CALLS=25

# --- YouTube auto video lookup (optional) --- YouTube Data API v3 key
YOUTUBE_API_KEY=

# Rate-limit storage. Use redis://... when running more than one worker/instance.
RATELIMIT_STORAGE_URI=memory://
# Number of reverse proxies in front of the app (Firebase Hosting + Cloud Run = 2, local = 0).
PROXY_FIX_HOPS=0
SHARE_LINK_DAYS=7

# The address people use (production). Behind Firebase Hosting the app only sees its
# *.run.app host, so links, OAuth redirects and share URLs are built from this.
# PUBLIC_URL=https://YOUR-PROJECT-ID.web.app
